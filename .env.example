# 环境变量示例文件
# 复制此文件为 .env 并修改相应配置
# 应用配置
VITE_APP_NAME=Fly For Fun
VITE_APP_VERSION=1.9.1
VITE_APP_DESCRIPTION=飞飞世界 - Vue3版本

# API配置
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# 游戏配置
VITE_GAME_MAX_LEVEL=200
VITE_GAME_MAX_INVENTORY_SLOTS=165
VITE_GAME_AUTO_SAVE_INTERVAL=30

# 开发配置
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=localhost

# 构建配置
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true
