{
  "name": "flyff-vue3",
  "version": "1.0.0",
  "description": "Fly For Fun - Vue3 + Vite 版本",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js",
    "build": "cd server && go build -o flyff-server.exe . && cd .. && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs --cache --cache-location node_modules/.cache/eslint --ignore-path .gitignore --ignore-pattern src/data/** --ignore-pattern src/assets/data/**",
    "update-data": "node scripts/update-flyff-data.mjs",
    "audit-data": "node scripts/audit-flyff-data.mjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "lz-string": "^1.5.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "opencc-js": "^1.4.1",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
