# 基础配置：所有文本文件自动识别，Git 处理换行符
* text=auto

# ========== 文本文件 - 强制使用 LF 换行符 ==========
# 文档类
*.md text eol=lf
*.txt text eol=lf
*.mdx text eol=lf

# 配置类
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf
*.mignore text eol=lf
*.gitignore text eol=lf

# 前端代码类
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.htm text eol=lf

# 脚本/配置类
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# ========== 二进制文件 - 不处理换行符 ==========
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# 压缩包
*.zip binary
*.rar binary
*.7z binary
*.tar.gz binary

# 其他二进制文件
*.dll binary
*.exe binary
*.so binary
*.dylib binary